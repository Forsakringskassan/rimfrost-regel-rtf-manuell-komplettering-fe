# BFF base URL.
#
# Leave empty to use the Vite dev proxy (vite.config.ts forwards /api to
# http://localhost:9004). Same origin, so no CORS configuration is needed.
#
# Set an absolute URL to call the BFF directly — then add this app's dev origin
# to the BFF's CORS_ORIGINS, e.g. CORS_ORIGINS=http://localhost:3032
VITE_BFF_URL=

# Standalone dev only: a handlaggningId from the OUL, used when no host portal
# passes one in.
VITE_DEV_HANDLAGGNING_ID=
